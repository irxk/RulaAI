# このファイルを .env にコピーして使います。
# .env は絶対に公開しないこと。

# APIキーは make_api_key.py が自動で書き込みます(手で編集しないでください)。
# RULA_API_KEY_SALT=...
# RULA_API_KEY_HASH=...

# APIの待ち受けポート(既定 8000)。127.0.0.1 のみで待ち受けます。
RULA_API_PORT=8000

# 固定URLで公開するホスト名。setup_tunnel.ps1 が設定します。
# RULA_HOSTNAME=api.example.com


# --- メインAI ---
# Main RulaはTabbyAPI + ExLlamaV3でQwen3.5 9B EXL3 2.50bpwを使います。
# TabbyAPIとモデルを別途インストールし、起動してからRulaを開いてください。
# tabbyapi-config.yml をTabbyAPIフォルダの config.yml として使えます。
# RULA_MAIN_BACKEND=tabbyapi
# RULA_TABBYAPI_BASE_URL=http://127.0.0.1:5000/v1
# RULA_TABBYAPI_MODEL=Qwen3.5-9B-EXL3-2.5bpw
# TabbyAPIの api_tokens.yml にある一般APIキーを設定します。
# RULA_TABBYAPI_API_KEY=...
# モデルのロード/解放に使うadminキーも設定します。
# RULA_TABBYAPI_ADMIN_KEY=...
# 起動時のロード設定 (既定は8Kコンテキスト・Q4 KV cache)。
# RULA_TABBYAPI_MAX_SEQ_LEN=8192
# RULA_TABBYAPI_CACHE_SIZE=8192
# RULA_TABBYAPI_CACHE_MODE=Q4
#
# OllamaをメインAIに使う場合:
# RULA_MAIN_BACKEND=ollama
# RULA_MAIN_OLLAMA_MODEL=llama3.1:8b
# RULA_MAIN_NUM_CTX=8192
# RULA_MAIN_KEEP_ALIVE=0
#
# StrataをメインAIに使う場合:
# RULA_MAIN_BACKEND=strata
# RULA_STRATA_BASE_URL=http://127.0.0.1:8080/v1
# Strataで複数モデルを配信している場合は、/v1/models にあるIDを必ず指定してください。
# RULA_STRATA_MODEL=モデルID
# StrataでAPIキーを設定した場合のみ:
# RULA_STRATA_API_KEY=...
# Strataを別PCへ接続する場合はAPIキーとHTTPSを使用してください。
# 画像対応モデルを vision on で起動した場合:
# RULA_STRATA_VISION=1
# Ollamaのコンテキスト長などは上のRULA_MAIN_*設定で指定します。
#
# RulaCoderはExLlamaV2でQwen2.5-Coder-7B-Instruct EXL2 4.0bpwを使います。
# EXL2モデルとTabbyAPIのPython環境は別途必要です。install-coder-v2.ps1で公式wheelを導入します。
# PlannerにはQwen3.5 9B EXL3を使い、Coderと順番にロード/解放します(同時起動・同時推論はしないこと)。
# RULA_CODER_BACKEND=exllamav2
# RULA_CODER_V2_MODEL=Qwen2.5-Coder-7B-Instruct-4.0bpw-exl2
# RULA_CODER_V2_MODEL_DIR=C:\Users\<ユーザー名>\AppData\Local\Programs\TabbyAPI\models\Qwen2.5-Coder-7B-Instruct-4.0bpw-exl2
# RULA_CODER_V2_BASE_URL=http://127.0.0.1:5101/v1
# RULA_CODER_V2_MAX_SEQ_LEN=8192
# RULA_CODER_V2_PYTHON=C:\Users\<ユーザー名>\AppData\Local\Programs\TabbyAPI\venv\Scripts\python.exe
# RULA_CODER_PLANNER_MODEL=Qwen3.5-9B-EXL3-2.5bpw
# V2を使わない場合、TabbyAPI/ExLlamaV3 Coderにも切替可能:
# RULA_CODER_BACKEND=tabbyapi
# RULA_CODER_TABBYAPI_MODEL=Qwen2.5-Coder-7B-Instruct-exl3
# RULA_CODER_TABBYAPI_MAX_SEQ_LEN=8192
# RULA_CODER_TABBYAPI_CACHE_SIZE=8192
# RULA_CODER_TABBYAPI_CACHE_MODE=Q4
# Ollama/Strataを明示的に使う場合はTabbyAPIのPlannerは使いません:
# RULA_CODER_BACKEND=ollama
# RULA_CODER_OLLAMA_MODEL=qwen2.5-coder:7b
# RULA_CODER_NUM_CTX=8192
# RULA_CODER_KEEP_ALIVE=0
# 文章題で自動的に考えるときの思考の上限(字数)。文章題 36 問の実測で、3000 でも
# 2000 でも全問正解、平均は 18.1 秒 → 13.2 秒。上げると遅く、下げすぎると誤答が増えます。
# RULA_AUTO_THINK_CAP=2000


# --- Discord Bot (DisBot/discord_bot.py を使う場合のみ) ---

# Botの接続先API。同じPCで動かすなら未設定でかまいません。
# 別のホスト(VPS・ホスティングサービス)でBotを動かす場合は必須です。
# そのホストの 127.0.0.1 はホスト自身を指すため、公開URLを指定してください。
# RULA_API_BASE=https://api.example.com

# Discord Developer Portal の Bot タブで発行するトークン。
# 同じ画面の MESSAGE CONTENT INTENT を ON にしないと本文を読めません。
# DISCORD_TOKEN=

# Botが使うAPIキー。make_api_key.py が表示した文字列そのものです。
# (上の SALT / HASH は照合用なので、ここには使えません)
# RULA_API_KEY=rula_...

# 思考モード: auto(既定) / on / off
#   auto — 計算・比較・理由を問う質問だけ考えてから答えます
#   on   — 毎回考えます。正確になりますが20秒ほど余分にかかります
#   off  — 考えません。最速
# DISCORD_THINK=auto

# 応答するサーバーをIDで限定します(未設定なら招待された全サーバー)。
# DISCORD_GUILDS=123456789012345678,987654321098765432
