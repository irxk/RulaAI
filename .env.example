# このファイルを .env にコピーして使います。
# .env は絶対に公開しないこと。

# APIキーは make_api_key.py が自動で書き込みます(手で編集しないでください)。
# RULA_API_KEY_SALT=...
# RULA_API_KEY_HASH=...

# APIの待ち受けポート(既定 8000)。127.0.0.1 のみで待ち受けます。
RULA_API_PORT=8000

# 固定URLで公開するホスト名。setup_tunnel.ps1 が設定します。
# RULA_HOSTNAME=api.example.com


# --- 推論 ---
# 既定では llama.cpp の llama-server を API が自分で起動して使います。
# 見つからなければ Ollama を使います。どちらかに固定するなら指定します。
# RULA_BACKEND=llama-server
# RULA_BACKEND=ollama

# llama-server 本体とモデル(未設定なら setup_llama.ps1 が置いた runtime\ と models\gguf\)。
# モデルは 9B(MTP付き)を優先し、無ければ 4B を使います。4B に固定するなら:
#   RULA_GGUF=C:\path\to\RulaAI\models\gguf\rula-4b-mtp-q4_k_m.gguf
# RULA_LLAMA_SERVER=C:\path\to\llama-server.exe
# RULA_GGUF=C:\path\to\model.gguf
# 画像を読むための部品。無ければ画像は読めません(none で無効化)。
# RULA_MMPROJ=C:\path\to\mmproj.gguf
# 1 で画像の部品をGPUに置く(既定 0 = CPU。VRAMは増えない)。
#   4B: 画像1枚 約6秒 → 約1秒、VRAM +760MB
#   9B: 約9秒 → 約4秒、VRAM +816MB。8GBのカードでは収まらず、はみ出して遅くなるので使わない。
# RULA_MMPROJ_GPU=0
# MTP(投機的デコード)。0 で無効: VRAM 約-490MB、生成速度は約2/3に。
# RULA_MTP=1
# MTPで先読みするトークン数。1 にすると VRAM が約210MB減り、速度は少し落ちる。
# RULA_MTP_DRAFT=2
# KVキャッシュの型。q8_0 は f16 より VRAM が約200MB少なく、速度は同じ(実測)。
# RULA_KV_TYPE=q8_0
# 1ターンで使える文脈の長さ(トークン)。
# RULA_NUM_CTX=16384
# llama-server の待ち受けポート。127.0.0.1 のみで待ち受けます。
# RULA_LLAMA_PORT=8081
# モデル名として名乗る名前(既定: 9B なら Rula2.0-9b、4B なら Rula1.2-4b)。
# RULA_DISPLAY_NAME=Rula2.0-9b
# 文章題で自動的に考えるときの思考の上限(字数)。文章題 36 問の実測で、3000 でも
# 2000 でも全問正解、平均は 18.1 秒 → 13.2 秒。上げると遅く、下げすぎると誤答が増えます。
# RULA_AUTO_THINK_CAP=2000


# --- Discord Bot (DisBot/discord_bot.py を使う場合のみ) ---

# Botの接続先API。同じPCで動かすなら未設定でかまいません。
# 別のホスト(VPS・ホスティングサービス)でBotを動かす場合は必須です。
# そのホストの 127.0.0.1 はホスト自身を指すため、公開URLを指定してください。
# RULA_API_BASE=https://api.example.com

# Discord Developer Portal の Bot タブで発行するトークン。
# 同じ画面の MESSAGE CONTENT INTENT を ON にしないと本文を読めません。
# DISCORD_TOKEN=

# Botが使うAPIキー。make_api_key.py が表示した文字列そのものです。
# (上の SALT / HASH は照合用なので、ここには使えません)
# RULA_API_KEY=rula_...

# 思考モード: auto(既定) / on / off
#   auto — 計算・比較・理由を問う質問だけ考えてから答えます
#   on   — 毎回考えます。正確になりますが20秒ほど余分にかかります
#   off  — 考えません。最速
# DISCORD_THINK=auto

# 応答するサーバーをIDで限定します(未設定なら招待された全サーバー)。
# DISCORD_GUILDS=123456789012345678,987654321098765432
